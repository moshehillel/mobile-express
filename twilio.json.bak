        "loop": 1,
        "finish_on_key": "#",
        "stop_gather": true,
        "gather_language": "en",
        "speech_model": "default",
        "timeout": 8
      }
    },
    {
      "name": "split_confirm_address",
      "type": "split-based-on",
      "transitions": [
        {
          "next": "gather_confirm_address",
          "event": "noMatch"
        },
        {
          "next": "pay_1",
          "event": "match",
          "conditions": [
            {
              "friendly_name": "If value equal_to 1",
              "arguments": [
                "{{widgets.gather_confirm_address.Digits}}"
              ],
              "type": "equal_to",
              "value": "1"
            }
          ]
        },
        {
          "next": "say_address_incorrect",
          "event": "match",
          "conditions": [
            {
              "friendly_name": "If value equal_to 2",
              "arguments": [
                "{{widgets.gather_confirm_address.Digits}}"
              ],
              "type": "equal_to",
              "value": "2"
            }
          ]
        }
      ],
      "properties": {
        "input": "{{widgets.gather_confirm_address.Digits}}",
        "offset": {
          "x": 9520,
          "y": -3000
        }
      }
    },
    {
      "name": "say_address_incorrect",
      "type": "say-play",
      "transitions": [
        {
          "event": "audioComplete"
        }
      ],
      "properties": {
        "offset": {
          "x": 9520,
          "y": -3400
        },
        "loop": 1,
        "say": "No problem. We will send your recording to our customer service team for processing your order. Thank you for calling Mobile Express, goodbye."
      }
    }
  ]
}